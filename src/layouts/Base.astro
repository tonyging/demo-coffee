---
import '../styles/global.css';
import { getData, SANITY_PROJECT_ID, SANITY_DATASET } from '../lib/data';
import { url } from '../lib/format';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'about' | 'beans' | 'news' | 'contact' | 'backend';
  noindexHint?: boolean;
}
const { title, description = '嵐岸咖啡 Lan’an Roastery：大稻埕的小型自家烘焙，單品豆、配方豆與濾掛。（作品範例網站，品牌與內容皆為虛構）', current } = Astro.props;
const data = await getData();
const fullTitle = title ? `${title}｜嵐岸咖啡（作品範例）` : '嵐岸咖啡（作品範例）｜山的味道，在岸邊慢慢烘開';
const ogDesc = description.includes('作品範例') ? description : `作品範例｜${description}`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${import.meta.env.BASE_URL}og.jpg`, Astro.site).href;

const nav = [
  { key: 'home', label: '首頁', href: url('') },
  { key: 'about', label: '關於我們', href: url('about/') },
  { key: 'beans', label: '咖啡豆', href: url('beans/') },
  { key: 'news', label: '最新消息', href: url('news/') },
  { key: 'contact', label: '聯絡我們', href: url('contact/') },
];
const { store } = data;
const live = SANITY_PROJECT_ID ? { id: SANITY_PROJECT_ID, ds: SANITY_DATASET } : null;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3EDE4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17110D" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="嵐岸咖啡（作品範例）" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="嵐岸咖啡示範網站首頁：諾豪資訊製作的示範作品" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@700&family=Noto+Sans+TC:wght@400;700&family=DM+Mono:wght@400&family=Cormorant+Garamond:ital,wght@1,500&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@700&family=Noto+Sans+TC:wght@400;700&family=DM+Mono:wght@400&family=Cormorant+Garamond:ital,wght@1,500&display=swap"
      />
    </noscript>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('lanan-theme');
          if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
        document.documentElement.classList.add('js');
      })();
    </script>
    {live && <meta name="sanity-live" content={`${live.id}|${live.ds}`} />}
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>

    <div class="demo-bar" role="note">
      <div class="wrap">
        <span><span class="demo-bar__long">這是諾豪資訊製作的網站作品範例，品牌與內容皆為虛構。</span><span class="demo-bar__short">諾豪資訊的網站作品範例，內容皆為虛構。</span></span>
        <a href="https://tonyging.github.io/knowhow/#portfolio" target="_blank" rel="noopener">看更多作品 →</a>
      </div>
    </div>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('')} aria-label="嵐岸咖啡 首頁">
          <span class="brand__mark">嵐岸</span>
          <span class="brand__en">Lan’an Roastery</span>
        </a>
        <div class="header-tools">
          <nav class="nav" id="nav" aria-label="主選單">
            {nav.map((n) => (
              <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
            ))}
            <a class="nav__demo" href={url('backend-demo/')} aria-current={current === 'backend' ? 'page' : undefined}>後台怎麼用</a>
          </nav>
          <button class="icon-btn theme-toggle" type="button" aria-label="切換淺色／深色模式" data-theme-toggle>
            <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg>
            <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <button class="icon-btn menu-btn" type="button" aria-label="開啟選單" aria-expanded="false" aria-controls="nav" data-menu-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <section class="footer-cta" aria-labelledby="footer-cta-t">
          <div>
            <h2 id="footer-cta-t">這個網站是誰做的？想要類似的網站？</h2>
            <p>網站與後台由諾豪資訊製作。嵐岸咖啡是虛構的品牌，用來示範：網站長什麼樣子、店家自己怎麼改內容。想為自己的店做一個，歡迎直接聊聊。</p>
          </div>
          <div class="footer-cta__btns">
            <a class="btn" href="https://tonyging.github.io/knowhow/" target="_blank" rel="noopener">諾豪資訊官網 <span class="arr" aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href="https://line.me/R/ti/p/@879gqgah" target="_blank" rel="noopener">LINE 詢問 <span class="arr" aria-hidden="true">→</span></a>
          </div>
        </section>
        <div class="footer-grid">
          <div>
            <p class="footer-big">嵐岸<small>Lan’an Roastery</small></p>
            <p class="eyebrow" style="max-width: 24em" data-store="tagline">{store.tagline}</p>
          </div>
          <div class="footer-col">
            <h2>頁面</h2>
            {nav.slice(1).map((n) => <a href={n.href}>{n.label}</a>)}
          </div>
          <div class="footer-col">
            <h2>門市</h2>
            <p data-store="address">{store.address}</p>
            <p class="num" data-store="phone">{store.phone}</p>
          </div>
          <div class="footer-col">
            <h2>作品範例</h2>
            <a href={url('backend-demo/')}>後台怎麼用</a>
            <a href="https://tonyging.github.io/knowhow/" target="_blank" rel="noopener">諾豪資訊</a>
            <p>網站與後台由諾豪資訊製作。</p>
          </div>
        </div>
        <div class="footer-base">
          <span>© 嵐岸咖啡（虛構品牌）。作品範例，非真實店家。</span>
          <a class="footer-made" href="https://tonyging.github.io/knowhow/#portfolio" target="_blank" rel="noopener">諾豪資訊 Knowhow 製作的示範作品・看更多作品 →</a>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/site.ts';
    </script>
    <script>
      import '../scripts/live.ts';
    </script>
  </body>
</html>
