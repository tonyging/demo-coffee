# 嵐岸咖啡 — 環境變數範本（複製成 .env 再使用；.env 不會進版控）

# 網站（Astro）— 這兩個可以公開，不是金鑰
# 留空 = 使用 src/data/seed.json 的種子資料建置
PUBLIC_SANITY_PROJECT_ID=nxbcmng6
PUBLIC_SANITY_DATASET=production

# 匯入種子資料用（npm run import-seed）— 這是金鑰！只放本機 .env，絕對不要提交或貼給別人
# 到 https://www.sanity.io/manage → 專案 → API → Tokens 建立一組「Editor」權限的 token
SANITY_WRITE_TOKEN=
